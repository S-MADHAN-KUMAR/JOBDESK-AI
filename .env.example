# Copy to .env (never commit .env)
# Secrets stay on backend/worker containers — do not put API keys in frontend/.env

# App
SECRET_KEY=change-me-to-a-strong-random-value
DJANGO_SECRET_KEY=${SECRET_KEY}
FIELD_ENCRYPTION_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Neon PostgreSQL (external) — Compose does NOT run Postgres locally
DATABASE_URL=postgresql://user:password@ep-xxxx-yyyy.us-east-2.aws.neon.tech/neondb?sslmode=require

# Redis — Compose provides redis:6379; leave REDIS_URL unset for local Compose
# For hosted Redis: REDIS_URL=rediss://default:password@your-redis-host:6379

# Optional LLM / email keys — server-side only
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
RESEND_API_KEY=

# Browser-facing API URL baked into Next.js image at build time
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# VPS: NEXT_PUBLIC_API_URL=https://your-domain.com/api
