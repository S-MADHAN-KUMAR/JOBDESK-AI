# Copy to .env (never commit .env). Compose also reads backend/.env if present.
# Secrets stay on the backend / worker containers — do not put API keys in frontend/.env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
FIELD_ENCRYPTION_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Neon PostgreSQL (external). Compose does not run Postgres locally.
DATABASE_URL=postgresql://user:password@ep-xxxx-yyyy.us-east-2.aws.neon.tech/neondb?sslmode=require

# Redis is provided by Compose as the `redis` service. Do not point workers
# at a laptop localhost URL — Compose overrides REDIS_URL to redis://redis:6379/0.
# Optional hosted Redis (leave unset for local Compose):
# REDIS_URL=rediss://default:password@your-redis-host:6379

# Optional LLM / email keys — server-side only
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
RESEND_API_KEY=

# Browser-facing API URL baked into the Next.js image at build time.
# Local Compose (ports published on the host):
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# VPS behind nginx (`docker compose --profile prod up`):
# NEXT_PUBLIC_API_URL=https://your-domain.com/api
# CORS_ALLOWED_ORIGINS=https://your-domain.com
# CSRF_TRUSTED_ORIGINS=https://your-domain.com
# FRONTEND_URL=https://your-domain.com
# ALLOWED_HOSTS=your-domain.com,backend
