# Same-origin API (recommended): leave unset or set to /api.
# Next.js rewrites /api → BACKEND_ORIGIN (see next.config.ts) so JWT cookies
# are stored on the frontend host and middleware can block /login when signed in.
NEXT_PUBLIC_API_URL=/api

# Django origin used only by the Next.js rewrite (server-side).
BACKEND_ORIGIN=http://127.0.0.1:8000
