# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Neon PostgreSQL (serverless). Get a connection string from https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxxx-yyyy.us-east-2.aws.neon.tech/neondb?sslmode=require

# Cloud Redis (Upstash / Redis Cloud). Get REDIS_URL from your provider dashboard.
# Example (Upstash): rediss://default:password@us1-xxx.upstash.io:6379
REDIS_URL=rediss://default:password@your-redis-host:6379

# Frontend origin(s) allowed to call the API via CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
